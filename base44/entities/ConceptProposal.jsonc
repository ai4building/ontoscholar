{
  "name": "ConceptProposal",
  "type": "object",
  "properties": {
    "question_id": {
      "type": "string"
    },
    "paper_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "definition": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    }
  },
  "required": [
    "name",
    "rationale"
  ]
}